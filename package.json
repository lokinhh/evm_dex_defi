{
  "name": "evm-dex-defi",
  "version": "1.0.0",
  "private": true,
  "description": "EVM DEX with liquidity pools, AMM swaps, and LP staking — Ethereum & BSC",
  "author": "Loc Nguyen Huu",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "e2e": "hardhat run simulator/e2e.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:bsc": "hardhat run scripts/deploy.js --network bscTestnet",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "verify:bsc": "hardhat run scripts/verify.js --network bscTestnet",
    "node": "hardhat node",
    "dev": "concurrently -n chain,web -c yellow,cyan \"npm run node\" \"npm run dev:web\"",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm run compile && npm --prefix frontend run build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.2.0",
    "chai": "^4.5.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.18"
  }
}
